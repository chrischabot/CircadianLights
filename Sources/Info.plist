<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>CircadianLights</string>
    <key>CFBundleIdentifier</key>
    <string>com.circadianlights.app</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
